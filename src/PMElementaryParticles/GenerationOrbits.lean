import PMElementaryParticles.GluedExcursions
import PMKAutomaton.ClockTickWeights
import PMKAutomaton.Machine.SliceHop
import PersistenceMechanics.SelectionSymmetry

/-!
# Generation orbits of the existing slice symmetries

The cited Closure applications supply slice-root reflections, not a bundled
full clock stabilizer. `sliceGroup` packages exactly those generators as a
subgroup of lattice permutations. It adds no triality, sector exchange or
other clock-fixing map. SliceHop's two swaps are restrictions of these same
reflections (`sliceHop_swaps`).

Every generator has zero glue key. Thus every group element fixes every glue
key, not just the clock coset. It also fixes every generation's channel vector
pointwise. Restriction to any ProgramClasses class removes no group elements.
The induced permutation group on the three nonzero keys is the identity group.
Each generation orbit is a singleton, for all five visible classes.

| Visible class | Species from CarrierChannels | Generation partition | Declared tiers |
| --- | --- | --- | --- |
| 0 | up | {0}, {1}, {2} | {0,2,3} |
| 0 | down | {0}, {1}, {2} | {0,1,2} |
| 1 | up | {0}, {1}, {2} | {0,2,3} |
| 2 | down | {0}, {1}, {2} | {0,1,2} |
| 3 | electron | {0}, {1}, {2} | {0,1,2} |
| 3 | neutrino | {0}, {1}, {2} | {0,1,2} |
| 5 | electron | {0}, {1}, {2} | {0,1,2} |

Indices are EPLabelGen.genIndex: 0 = (0,1), 1 = (1,0), 2 = (1,1).
The tier lists are TierLedger.tiersFor, not assignments of those indices.
GluedExcursions.class_species_inventory certifies the seven class/species
rows using the carrier axis, sign and wall rule. No light/heavy index is derived.
The singleton partition cannot explain the up-type tier difference.
There is no forced cross-generation tie to break under this group.
The 33-displacement image check uses the identity witness within singleton
orbits; it asserts no relation between two distinct generations.

Closure gives cost equality along program orbits, conditional on invariance.
It gives no equality between distinct generations for these generators. A
separating invariant below demonstrates this logical freedom; it is not a
physical cost reading. No event-count functional or generation-to-tier map is
selected. An arbitrary cost on Program need not factor through class and
generation; equality of those two fields alone does not imply equal cost.

These statements concern the generators used by ClockTickWeights and SliceHop.
The full sector-preserving clock-root stabilizers are now classified in
PMKAutomaton.ClockSymmetry and ClockSymmetryGenerators. Their label restrictions
and typed program action are in FullGenerationOrbits. The slice report above
is not the full-group Closure conclusion. The root cu and the 43-state reading
using cv still impose different symmetry conditions.
-/

noncomputable section
namespace PMElementaryParticles.GenerationOrbits
open PMKAutomaton.ClockRing PMKAutomaton.ClockAlignment
open PMKAutomaton.ClockTickWeights PMSubstrate.Lattices
open PMElementaryParticles.EPSpine PMElementaryParticles.EPLabelGen
open PMElementaryParticles.ProgramClasses PMConstants.PacketGaugeActions
open PMAction.SubstrateWeylRoots (reflectIn)

private theorem pair_sub (x y z : V) : pairing (x-y) z = pairing x z - pairing y z := by
  simp [sub_eq_add_neg, pair_add_left, pair_neg_left]

private theorem pair_symm (x y : V) : pairing x y = pairing y x := by
  simpa only [pairing, gram_symmetric] using Matrix.dotProduct_transpose_mulVec gram x y

private theorem reflection_pair (r z : V) (hr : pairing r r = 2) :
    pairing (reflectIn r z) r = -pairing z r := by
  rw [reflectIn, pair_sub, pair_smul_left, hr]
  ring

private theorem reflection_involutive (r : V) (hr : pairing r r = 2) :
    Function.Involutive (reflectIn r) := by
  intro z
  have hp := reflection_pair r z hr
  ext i
  change (reflectIn r z) i - pairing (reflectIn r z) r * r i = z i
  rw [hp]
  change z i - pairing z r * r i - -pairing z r * r i = z i
  ring

/-- These are exactly ClockTickWeights' twelve reflection directions. -/
def SliceRoot := {r : V // r ∈ sliceRoots}

private theorem slice_norm (r : SliceRoot) : pairing r.val r.val = 2 :=
  rootList_roots _ (List.mem_filter.mp (List.mem_filter.mp r.property).1).1

/-- The existing integral root reflection, bundled as its involutive permutation. -/
def sliceReflection (r : SliceRoot) : Equiv.Perm V :=
  (reflection_involutive r.val (slice_norm r)).toPerm

/-- The group generated by the reflections already used in ClockTickWeights. -/
def sliceGroup : Subgroup (Equiv.Perm V) :=
  Subgroup.closure (Set.range sliceReflection)

private def keyHom : V →+ (ZMod 2 × ZMod 2) where
  toFun := glueKey
  map_zero' := by decide +kernel
  map_add' := glueKey_add

/-- Zero-key reflection directions preserve all glue keys. -/
theorem reflection_key (z r : V) (hr : glueKey r = 0) :
    glueKey (reflectIn r z) = glueKey z := by
  change keyHom (z - pairing z r • r) = keyHom z
  rw [map_sub, map_zsmul]
  change keyHom z - pairing z r • glueKey r = keyHom z
  rw [hr, smul_zero, sub_zero]

private theorem slice_key (r : SliceRoot) : glueKey r.val = 0 :=
  (of_decide_eq_true (List.mem_filter.mp (List.mem_filter.mp r.property).1).2 : spacetimeProp r.val).1

/-- Generator invariance extends to the generated group, including inverses. -/
theorem invariant_of_generators {A : Type*} (f : V → A)
    (hf : ∀ r : SliceRoot, ∀ z, f (reflectIn r.val z) = f z)
    (s : sliceGroup) : ∀ z, f (s.val z) = f z := by
  rcases s with ⟨s, hs⟩
  change ∀ z, f (s z) = f z
  induction hs using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨r, rfl⟩ := hx
    exact hf r
  | one => exact fun _ => rfl
  | mul x y hx hy ihx ihy => exact fun z => (ihx (y z)).trans (ihy z)
  | inv x hx ih =>
    intro z
    simpa using (ih (x⁻¹ z)).symm

/-- No cited clock-slice symmetry permutes the generation keys. -/
theorem group_preserves_key (s : sliceGroup) (z : V) :
    glueKey (s.val z) = glueKey z :=
  invariant_of_generators glueKey (fun r z => reflection_key z r.val (slice_key r)) s z

theorem group_preserves_clock (s : sliceGroup) (z : V) :
    clockReading (s.val z) = clockReading z :=
  invariant_of_generators clockReading
    (fun r z => clockReading_reflect z r.val (sliceRoots_silent _ r.property)) s z

/-- The actual induced permutation, with `group_preserves_key` as its descent proof. -/
def generationAction : sliceGroup →* Equiv.Perm Generation := 1

theorem generationAction_key (s : sliceGroup) (g : Generation) (z : V)
    (hz : glueKey z = g.val) :
    glueKey (s.val z) = (generationAction s g).val := by
  rw [group_preserves_key, hz]
  rfl

/-- The descended action is forced to be the identity, not chosen to be so. -/
theorem generationAction_unique (s : sliceGroup) (t : Equiv.Perm Generation)
    (ht : ∀ (g : Generation) (z : V), glueKey z = g.val →
      glueKey (s.val z) = (t g).val) : t = generationAction s := by
  apply Equiv.ext
  intro g
  obtain ⟨z, _, hz⟩ := exists_root_of_key g
  apply Subtype.ext
  exact (ht g z hz).symm.trans ((group_preserves_key s z).trans hz)

/-- The induced permutation group on the three nonzero keys is trivial. -/
theorem generationAction_range : generationAction.range = ⊥ := by
  ext p
  change (∃ s, generationAction s = p) ↔ p = 1
  constructor
  · rintro ⟨s, rfl⟩; rfl
  · rintro rfl; exact ⟨1, rfl⟩

/-- The finite action table is the identity on all three library indices. -/
theorem generation_action_table : ∀ g : Fin 3,
    genIndex (generationAction 1 (GluedExcursions.generationAt g)) = g := by
  decide +kernel

/-- All generation-specific channel placements are fixed, before taking classes. -/
theorem slice_fixes_channels : ∀ r ∈ sliceRoots, ∀ (g : Fin 3) (c : Channels),
    reflectIn r (channelE8Gen g c) = channelE8Gen g c := by
  decide +kernel

theorem group_fixes_channels (s : sliceGroup) (g : Fin 3) (c : Channels) :
    s.val (channelE8Gen g c) = channelE8Gen g c := by
  rcases s with ⟨s, hs⟩
  change s (channelE8Gen g c) = channelE8Gen g c
  induction hs using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨r, rfl⟩ := hx
    exact slice_fixes_channels r.val r.property g c
  | one => rfl
  | mul x y hx hy ihx ihy => change x (y _) = _; rw [ihy, ihx]
  | inv x hx ih => exact (Equiv.symm_apply_eq x).2 ih.symm

/-- Both swaps from SliceHop are restrictions of existing slice reflections. -/
theorem sliceHop_swaps :
    PMAction.ClockEps.rootE8 ![1, 2, 0, 0] ∈ sliceRoots ∧
    PMAction.ClockEps.rootE8 ![0, 0, 1, 2] ∈ sliceRoots ∧
    ∀ t : PMAction.AxisHop.Tri, PMAction.AxisHop.IsRoot t →
      (reflectIn (PMAction.ClockEps.rootE8 ![1, 2, 0, 0])
        (PMAction.ClockEps.rootE8 t) = PMAction.ClockEps.rootE8 (PMAction.SliceHop.swap01 t)) ∧
      (reflectIn (PMAction.ClockEps.rootE8 ![0, 0, 1, 2])
        (PMAction.ClockEps.rootE8 t) = PMAction.ClockEps.rootE8 (PMAction.SliceHop.swap23 t)) := by
  decide +kernel

/-! ## The label-respecting restriction and its generation orbits -/

/-- The class-level condition in the question. The channel may move within its
existing weak/colour orbit; the image generation is the induced key action. -/
def RespectsClass (s : sliceGroup) (k : Fin 6) : Prop :=
  ∀ (g : Generation) (c : Channels), classOf c = k →
    ∃ d : Channels, classOf d = k ∧ ProgramClasses.Joined c d ∧
      s.val (channelE8Gen (genIndex g) c) =
        channelE8Gen (genIndex (generationAction s g)) d

theorem respectsClass_all (s : sliceGroup) (k : Fin 6) : RespectsClass s k := by
  intro g c hc
  exact ⟨c, hc, class_transitive c c rfl, group_fixes_channels s _ c⟩

/-- This is a restriction of the cited group, not a new symmetry assumption. -/
def classGroup (k : Fin 6) : Subgroup sliceGroup where
  carrier := {s | RespectsClass s k}
  one_mem' := respectsClass_all 1 k
  mul_mem' := fun _ _ => respectsClass_all _ k
  inv_mem' := fun _ => respectsClass_all _ k

theorem classGroup_eq_top (k : Fin 6) : classGroup k = ⊤ := by
  ext s
  exact iff_of_true (respectsClass_all s k) (Subgroup.mem_top s)

/-- Reachability of generation indices under the class-respecting group. -/
def SameGenerationOrbit (k : Fin 6) (g h : Fin 3) : Prop :=
  ∃ s : classGroup k,
    genIndex (generationAction s.val (GluedExcursions.generationAt g)) = h

/-- All five visible classes (indeed all six classes) have singleton orbits. -/
theorem sameGenerationOrbit_iff (k : Fin 6) (g h : Fin 3) :
    SameGenerationOrbit k g h ↔ g = h := by
  constructor
  · rintro ⟨s, hs⟩
    simpa only [generationAction, MonoidHom.one_apply, Equiv.Perm.one_apply,
      GluedExcursions.generationAt_index] using hs
  · rintro rfl
    exact ⟨1, GluedExcursions.generationAt_index g⟩

/-- A finite orbit report, certified against actual group reachability below. -/
def orbitPartition : Finset (Finset (Fin 3)) := Finset.univ.image (fun g => {g})

theorem orbitPartition_table : orbitPartition = {{0}, {1}, {2}} := by decide +kernel

theorem orbitPartition_correct (k : Fin 6) (g h : Fin 3) :
    SameGenerationOrbit k g h ↔ ∃ o ∈ orbitPartition, g ∈ o ∧ h ∈ o := by
  rw [sameGenerationOrbit_iff]
  revert g h
  decide +kernel

/-! ## Action on typed programs and the conditional cost consequence -/

private theorem reflection_norm (r z : V) (hr : pairing r r = 2) :
    pairing (reflectIn r z) (reflectIn r z) = pairing z z := by
  have h : ∀ x y z : V, pairing x (y-z) = pairing x y - pairing x z := by
    intro x y z
    rw [pair_symm, pair_sub, pair_symm y, pair_symm z]
  have hs : ∀ (n : ℤ) (x y : V), pairing x (n • y) = n * pairing x y := by
    intro n x y
    rw [pair_symm, pair_smul_left, pair_symm y]
  rw [reflectIn, pair_sub, h, hs, h, hs, pair_smul_left, pair_smul_left, hr, pair_symm r z]
  ring

theorem group_preserves_norm (s : sliceGroup) (z : V) :
    pairing (s.val z) (s.val z) = pairing z z :=
  invariant_of_generators (fun z => pairing z z)
    (fun r z => reflection_norm r.val z (slice_norm r)) s z

/-- Only the packet moves. The reference and firing data are retained. -/
def programAction (s : sliceGroup) (p : Program) : Program where
  label := p.label
  generation := generationAction s p.generation
  reference := p.reference
  firing := p.firing
  packet := s.val p.packet
  packet_root := rootList_complete _ ((group_preserves_norm s p.packet).trans
    (rootList_roots p.packet p.packet_root))
  packet_key := generationAction_key s p.generation p.packet p.packet_key

theorem programAction_generation (s : sliceGroup) (p : Program) :
    (programAction s p).generation = p.generation := rfl

theorem programAction_one (p : Program) : programAction 1 p = p := by
  cases p
  rfl

theorem programAction_mul (s t : sliceGroup) (p : Program) :
    programAction (s*t) p = programAction s (programAction t p) := by
  cases p
  rfl

/-- The existing clock readout and all six ring pillars are unchanged. -/
theorem programAction_ring (s : sliceGroup) (p : Program) :
    (programAction s p).toRing = p.toRing := by
  unfold Program.toRing
  congr 1
  exact congrArg PMKAutomaton.ClockRing.toFin (group_preserves_clock s p.packet)

theorem programAction_pillars (s : sliceGroup) (p : Program) :
    (programAction s p).Pillars ↔ p.Pillars := by
  unfold Program.Pillars
  rw [programAction_ring]

/-- Related programs, rather than all programs sharing a class and generation. -/
def SameProgramOrbit (k : Fin 6) (p q : Program) : Prop :=
  classOf p.label = k ∧ ∃ s : classGroup k, q = programAction s.val p

/-- Invariance gives equality along an orbit of any supplied action. This
shared form applies to both the slice and full stabilizer actions. -/
theorem invariant_cost_equal {H U A : Type*} (act : H → U → U) (cost : U → A)
    (hinvariant : ∀ (s : H) (p : U), cost (act s p) = cost p)
    (p q : U) (h : ∃ s : H, q = act s p) : cost q = cost p := by
  obtain ⟨s, rfl⟩ := h
  exact hinvariant s p

/-- In particular, no program orbit connects distinct generations. -/
theorem sameProgramOrbit_generation (k : Fin 6) (p q : Program)
    (h : SameProgramOrbit k p q) : q.generation = p.generation := by
  obtain ⟨_, s, rfl⟩ := h
  rfl

/-- An arbitrary invariant diagnostic can separate generations. This supplies
no physical cost definition. -/
theorem generation_diagnostic_invariant (s : sliceGroup) (p : Program) :
    genIndex (programAction s p).generation = genIndex p.generation := rfl

theorem generation_diagnostic_separates (p q : Program)
    (h : p.generation ≠ q.generation) :
    genIndex p.generation ≠ genIndex q.generation :=
  fun heq => h (genIndex_bijective.injective heq)

/-- Even a real-valued invariant function need not tie distinct generations.
This is a logical counterexample to a forced equality, not a mass proposal. -/
theorem invariant_can_separate (p q : Program) (hne : p.generation ≠ q.generation) :
    ∃ f : Program → ℝ,
      (∀ (s : sliceGroup) (x : Program), f (programAction s x) = f x) ∧ f p ≠ f q := by
  refine ⟨fun x => ((genIndex x.generation).val : ℝ), fun _ _ => rfl, ?_⟩
  intro heq
  apply generation_diagnostic_separates p q hne
  apply Fin.ext
  change ((genIndex p.generation).val : ℝ) = ((genIndex q.generation).val : ℝ) at heq
  exact_mod_cast heq

/-! ## Checks against the raw two-root geometry -/

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
/-- Finite identity-image check of all three enumerated 33-displacement sets. -/
theorem displacement_identity_check : ∀ g : Fin 3,
    (GluedExcursions.displacements g).image id = GluedExcursions.displacements g := by
  decide +kernel

/-- Generations in one orbit have displacement sets related by the identity
member. There is no cross-generation pair in these orbits. -/
theorem orbit_displacements_image (k : Fin 6) (g h : Fin 3)
    (hgh : SameGenerationOrbit k g h) :
    ∃ s : sliceGroup,
      (GluedExcursions.displacements g).image s.val = GluedExcursions.displacements h := by
  obtain rfl := (sameGenerationOrbit_iff k g h).1 hgh
  exact ⟨1, displacement_identity_check g⟩

/-- The finite report uses the already proved diagonal orbit relation. -/
def finiteOrbit (g : Fin 3) : Finset (Fin 3) := Finset.univ.filter (fun h => g = h)

theorem finiteOrbit_correct (k : Fin 6) (g h : Fin 3) :
    h ∈ finiteOrbit g ↔ SameGenerationOrbit k g h := by
  simp [finiteOrbit, sameGenerationOrbit_iff]

/-- The same orbit table applies to each of the five visible classes. -/
theorem finite_orbit_table :
    finiteOrbit 0 = {0} ∧ finiteOrbit 1 = {1} ∧ finiteOrbit 2 = {2} := by
  decide +kernel

/-- Only the clock coset (index zero) has raw displacements reading ±2. -/
theorem two_tick_generation : ∀ g : Fin 3,
    ((2, 1) ∈ GluedExcursions.clockHistogram g ∧
      (41, 1) ∈ GluedExcursions.clockHistogram g) ↔ g = 0 := by
  intro g
  fin_cases g
  · change ((2, 1) ∈ GluedExcursions.clockHistogram 0 ∧
      (41, 1) ∈ GluedExcursions.clockHistogram 0) ↔ (0 : Fin 3) = 0
    rw [GluedExcursions.displacement_clocks.1]; decide +kernel
  · change ((2, 1) ∈ GluedExcursions.clockHistogram 1 ∧
      (41, 1) ∈ GluedExcursions.clockHistogram 1) ↔ (1 : Fin 3) = 0
    rw [GluedExcursions.displacement_clocks.2.1]; decide +kernel
  · change ((2, 1) ∈ GluedExcursions.clockHistogram 2 ∧
      (41, 1) ∈ GluedExcursions.clockHistogram 2) ↔ (2 : Fin 3) = 0
    rw [GluedExcursions.displacement_clocks.2.2]; decide +kernel

/-- The generation carrying the ±2 excursions is fixed, as are the others. -/
theorem two_tick_generation_fixed (s : sliceGroup) :
    generationAction s (GluedExcursions.generationAt 0) = GluedExcursions.generationAt 0 := rfl

end PMElementaryParticles.GenerationOrbits
