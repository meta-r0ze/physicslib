theorem allFrames_valid : ∀ i, ValidFrame (allFrames i) := by decide +kernel

theorem allFrames_complete : ∀ (p : Fin 3 → Fin 3) (n : Fin 3 → Bool),
    Function.Injective p → ∃ i : Fin 48, allFrames i = (p,n) := by decide +kernel

def signParity (f : SpatialFrame) : ℕ := (Finset.univ.filter fun i => f.2 i = true).card % 2

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
/-- The diagonal glue forces the same outer sign in both D4 factors. -/
theorem integral_sign_parity : ∀ (t : Bool) (i j : Fin 48),
    (∀ a b, (frameMatrix t (allFrames i) (allFrames j) * chartMatrix) a b % 4 = 0) →
      signParity (allFrames i) = signParity (allFrames j) := by
  have table : ∀ (t : Bool) (i j : Fin 48),
      signParity (allFrames i) = signParity (allFrames j) ∨
        ∃ a b, (frameMatrix t (allFrames i) (allFrames j) * chartMatrix) a b % 4 ≠ 0 := by
    decide +kernel
  intro t i j h
  rcases table t i j with hp | ⟨a,b,hbad⟩
  · exact hp
  · exact False.elim (hbad (h a b))

abbrev FramePair := SpatialFrame × SpatialFrame

def identityFrame : SpatialFrame := (id, fun _ => false)

def frameComp (f g : SpatialFrame) : SpatialFrame :=
  (fun i => f.1 (g.1 i), fun i => Bool.xor (g.2 i) (f.2 (g.1 i)))

def pairComp (f g : FramePair) : FramePair := (frameComp f.1 g.1, frameComp f.2 g.2)

def generatorFrames : Fin 7 → FramePair :=
  ![((![1,0,2],![false,false,false]),(![0,1,2],![false,false,false])),
    ((![0,2,1],![false,false,false]),(![0,1,2],![false,false,false])),
    ((![1,0,2],![true,true,false]),(![0,1,2],![false,false,false])),
    ((![0,1,2],![false,false,false]),(![1,0,2],![false,false,false])),
    ((![0,1,2],![false,false,false]),(![0,2,1],![false,false,false])),
    ((![0,1,2],![false,false,false]),(![1,0,2],![true,true,false])),
    ((![0,1,2],![true,false,false]),(![0,1,2],![true,false,false]))]

def wordFrames : List (Fin 7) → FramePair
  | [] => (identityFrame, identityFrame)
  | i :: is => pairComp (generatorFrames i) (wordFrames is)

