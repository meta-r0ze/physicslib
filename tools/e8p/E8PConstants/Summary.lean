import E8PConstants.Format
import E8PConstants.PMAtoms.Certified
import E8PConstants.PMAtoms.Shells

/-!
# `--summary`: one Markdown page of everything `e8p` compares

Reads only what the other views already report (`Catalog` bounds and theorem names,
`Experimental` references, `--masses`, `--shells`, the periodic-table Hund score). Nothing is
recomputed here except display quantities: the midpoint of each proved enclosure, its σ against
the reference, and the number of agreeing digits `⌊−log₁₀ |E8 − meas| / |meas|⌋`.

Output is Markdown so it can be written to `PREDICTIONS.md` as is.
-/

namespace E8PConstants.Summary

def absR (q : Rat) : Rat := if q ≥ 0 then q else -q

def pow10 (e : Int) : Rat :=
  if e ≥ 0 then ((10 ^ e.toNat : Nat) : Rat) else 1 / ((10 ^ (-e).toNat : Nat) : Rat)

/-- Decimal exponent `e` with `10^e ≤ |q| < 10^(e+1)` (searched in `[-40, 40]`). -/
def exponent (q : Rat) : Int :=
  let a := absR q
  ((List.range 81).map (fun i => (i : Int) - 40)).foldl
    (fun acc e => if pow10 e ≤ a then e else acc) (-40)

/-- `q` with `sig` significant digits: plain decimal for `10⁻³ ≤ |q| < 10⁷`, else `m×10^e`. -/
def showSig (q : Rat) (sig : Nat) : String :=
  if q = 0 then "0" else
  let e := exponent q
  let sign := if q < 0 then "-" else ""
  if -3 ≤ e ∧ e < 7 then
    let d := (((sig : Int) - 1 - e).toNat)
    sign ++ fixedDecimal (lowerScaled (absR q) d) d
  else
    let m := absR q / pow10 e
    sign ++ fixedDecimal (lowerScaled m (sig - 1)) (sig - 1) ++ s!"e{e}"

/-- Agreeing digits: largest `k ≤ 16` with `|c − v| · 10^k ≤ |v|`. -/
def agreeDigits (c v : Rat) : Nat :=
  if v = 0 then 0 else
  (List.range 17).foldl
    (fun acc k => if absR (c - v) * pow10 (Int.ofNat k) ≤ absR v then k else acc) 0

structure Cmp where
  key : Key
  ref : ExpRef
  digits : Nat
  sigma : Rat

def comparisons : List Cmp :=
  keys.flatMap fun k =>
    ((expRefs k).filter (fun r => scoredRef k r && r.uncertainty ≠ 0)).map fun r =>
      { key := k, ref := r, digits := agreeDigits (central k) r.value, sigma := sigmaRat k r }

def contextRefs : List (Key × ExpRef) :=
  keys.flatMap fun k => ((expRefs k).filter (fun r => !scoredRef k r)).map (fun r => (k, r))

/-- Escape `|` for a Markdown table cell. -/
def esc (s : String) : String := s.replace "|" "\\|"

def sigmaStr (s : Rat) : String :=
  let body := fixedDecimal ((s * 100).floor) 2
  if s ≥ 0 then "+" ++ body else body

def cmpRow (c : Cmp) : String :=
  let sig := min 15 (c.digits + 3)
  s!"| `{c.key.id}` | {showSig (central c.key) sig} | {showSig c.ref.value sig} ± {showSig c.ref.uncertainty 2} | {c.key.unit} | {c.digits} | {sigmaStr c.sigma} | {c.ref.citation} | `{c.key.theoremName}` |"

def summaryLines : List String :=
  let cs := comparisons.mergeSort (fun a b => decide (b.digits < a.digits ∨ (b.digits = a.digits ∧ absR a.sigma ≤ absR b.sigma)))
  let n := cs.length
  let within (t : Rat) := (cs.filter (fun c => absR c.sigma ≤ t)).length
  let withRef := (keys.filter (fun k => !(expRefs k).isEmpty)).length
  let tensions := (cs.filter (fun c => absR c.sigma > 2)).mergeSort
    (fun a b => decide (absR b.sigma ≤ absR a.sigma))
  let nuclei := certifiedNuclei 20
  let zs := nuclei.filterMap (fun p => scatterZ p.1 (p.2 - p.1))
  let zWithin (t : Rat) := (zs.filter (fun q => absQ q ≤ t)).length
  let hund := multiplicityScore 54
  let closures := Shells.largestGapFills 7
  let header := "| quantity | E8 (proved, midpoint) | measured | unit | digits | σ | reference | Lean theorem |"
  let rule := "|---|---:|---:|---|---:|---:|---|---|"
  [ "# E8 substrate vs measurement",
    "",
    "Generated by `e8p --summary` from the Lean tree. Every E8 number is the midpoint of a",
    "Lean-proved enclosure (theorem named per row); the enclosures are much narrower than the",
    "measurement errors unless noted. No parameter is fitted.",
    "",
    "**Inputs.** The E8 substrate integers `Δ = 43`, `ν = 16`, `σ = 5`, `χ = 2`, `D = 4`.",
    "**Unit inputs.** `m_e`, `ħc` and `c` (CODATA 2022), used only to express values in MeV, fm or s.",
    "",
    "## Scoreboard",
    "",
    s!"- {keys.length} values with proved enclosures; {withRef} have a measured reference.",
    s!"- {n} scored comparisons: |σ| ≤ 1: **{within 1}**, |σ| ≤ 2: **{within 2}**, |σ| ≤ 3: **{within 3}**.",
    s!"- {contextRefs.length} references shown for context and not scored (see below).",
    s!"- Nuclear masses (`--masses`): {zs.length} nuclei, |z| ≤ 1: {zWithin 1}, ≤ 2: {zWithin 2}, ≤ 3: {zWithin 3} in units of the ledger's stable-line scatter ({ratDecimal ledgerScatterME 1} m_e).",
    s!"- Nuclear shell closures (`--shells`): {closures}; measured magic numbers {Shells.measuredMagic}.",
    s!"- Atomic ground-state multiplicity, Hund's first rule (`--periodic-table`): {hund.1} of {hund.2} match.",
    "",
    "`digits` = ⌊−log₁₀(|E8 − measured| / |measured|)⌋. σ uses the measurement uncertainty only.",
    "",
    "## All scored comparisons, most digits first",
    "",
    header, rule ] ++ cs.map cmpRow ++
  [ "",
    "## Tensions (|σ| > 2)",
    "",
    header, rule ] ++ tensions.map cmpRow ++
  [ "",
    "## Shown, not scored",
    "",
    "| quantity | E8 (proved, midpoint) | reference | why not scored |",
    "|---|---:|---|---|" ] ++
  contextRefs.map (fun (k, r) =>
    s!"| `{k.id}` | {showSig (central k) 8} | {showSig r.value 8} ± {showSig r.uncertainty 2} ({r.citation}) | {esc k.caveat} |") ++
  [ "",
    s!"{(keys.filter (fun k => (expRefs k).isEmpty)).length} further values have proved enclosures and no measured reference (`e8p` lists them)." ]

end E8PConstants.Summary
